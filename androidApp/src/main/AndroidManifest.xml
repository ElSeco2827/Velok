<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Descarga del catálogo de ExerciseDB y de sus imágenes. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Health Connect: SOLO LECTURA de los 4 datos de la tarjeta "Actividad diaria". Deben coincidir
      con PERMISOS_HEALTH_CONNECT (shared/src/androidMain/.../data/salud/PermisosHealthConnect.kt).
      La app nunca pide permisos de escritura (solo la pantalla de datos de prueba de debug).
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!-- Saber si la app Health Connect está instalada (Android 9 a 13). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".VelokApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Velok">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Aviso de privacidad para el diálogo de permisos de Health Connect (Android 13 y menor). -->
        <activity
            android:name=".PoliticaPrivacidadSaludActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- El mismo aviso en Android 14+ (Health Connect integrado en el sistema). -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".PoliticaPrivacidadSaludActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
